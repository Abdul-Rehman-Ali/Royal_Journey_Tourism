<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/back01"
    tools:context=".HomeFragment">

    <!-- Loader to show until the image is loaded -->
<!--    <ProgressBar-->
<!--        android:id="@+id/progressLoader"-->
<!--        android:layout_width="wrap_content"-->
<!--        android:layout_height="wrap_content"-->
<!--        android:layout_gravity="center"-->
<!--        android:visibility="gone" />-->

    <!-- Vertical layout to stack ImageView, TextView, and Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- CardView for circular ImageView -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardViewHeader"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_gravity="center_horizontal"
            android:layout_margin="16dp"
            app:cardCornerRadius="75dp"
            app:cardElevation="4dp"
            android:clipChildren="true"
            android:clipToPadding="true">

            <!-- ImageView inside CardView -->
            <ImageView
                android:id="@+id/imgHeader"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/logo" />
        </androidx.cardview.widget.CardView>

        <!-- TextView below the ImageView -->
        <TextView
            android:id="@+id/tvHeaderText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Your Header Text Here"
            android:textSize="18sp"
            android:textColor="@android:color/black"
            android:gravity="center" />

        <!-- Button below the TextView -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHomeGenerateInvoice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Generate Invoice" />

    </LinearLayout>

</FrameLayout>
