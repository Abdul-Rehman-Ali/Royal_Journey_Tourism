            app:layout_constraintTop_toTopOf="@+id/textView9" />

        <TextView
            android:id="@+id/tvGrandTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Grand Total"
            android:textSize="24px"
            android:textStyle="bold"
            android:layout_marginEnd="20dp"
            android:fontFamily="@font/poppins_regular"
            app:layout_constraintEnd_toStartOf="@+id/tvGrandTotal"
            app:layout_constraintTop_toBottomOf="@+id/materialDivider11" />

    </LinearLayout>


    <ImageView
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_gravity="end"
        android:layout_marginEnd="320dp"
        android:scaleType="fitXY"
        android:layout_marginTop="2dp"
        android:src="@drawable/confirmtour"
        app:layout_constraintBottom_toTopOf="@+id/linearLayout000"
        app:layout_constraintEnd_toEndOf="parent" />


    <LinearLayout
        android:id="@+id/linearLayout000"
        android:layout_width="1000px"
        android:layout_height="wrap_content"
        android:background="@color/primaryColor"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginTop="40dp"
        android:paddingVertical="8px"
        app:layout_constraintBottom_toBottomOf="parent"
